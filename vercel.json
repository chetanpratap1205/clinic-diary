{
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/auto-resolve",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/push/send-reminders",
      "schedule": "*/5 * * * *",
      "comment": "30-min appointment reminder push notifications — fires every 5 min, zero cost"
    }
  ]
}
